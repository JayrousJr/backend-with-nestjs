#  app 
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
SERVER_URL=0.0.0.0
PORT=3005
API_PREFIX=api

#  database 
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/azamtv_db
# docker compose host ports (defaults 5432 / 6379)
POSTGRES_PORT=5432

# Email Configuration
MAIL_MAILER=
SMTP_HOST=
SMTP_PORT= 
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENCRYPTION=

#  redis 
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

#  jwt 
# minimum 32 characters
JWT_ACCESS_SECRET=<generate: openssl rand -base64 64>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<generate: openssl rand -base64 64>
JWT_REFRESH_EXPIRES_IN=7d
# encrypts TOTP (2FA) secrets at rest
TWO_FACTOR_ENCRYPTION_KEY=<generate: openssl rand -base64 48>

#  cors / throttle 
# comma-separated list of allowed origins
# 4173 also covers the prerender server (frontend scripts/prerender.mjs)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
THROTTLE_TTL=60000
THROTTLE_LIMIT=100


#  feature flags
ENABLE_MULTI_TENANCY=false
# unset = enabled outside production only
SWAGGER_ENABLED=true


 #  notifications — email (resend) 
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain.com

#  notifications — sms (africa's talking) 
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox

#  notifications — push (firebase) 
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

#  storage 
# local | s3
STORAGE_DRIVER=local
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# leave empty to use AWS default; set for MinIO or Cloudflare R2
AWS_S3_ENDPOINT=

#  observability 
SENTRY_DSN=


#  reverse proxy
# number of trusted proxy hops (nginx = 1); 0 disables X-Forwarded-For trust
TRUST_PROXY=0

#  docker compose (docker-compose.prod.yml) — required, no defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=azamtv_db
# refresh-token cookie: 'none' (+HTTPS) only if the SPA is on a different domain
COOKIE_SAMESITE=strict
# absolute sitemap URL for robots.txt; defaults to <FRONTEND_URL>/sitemap.xml.
# Point it at this API instead if you serve the sitemap from the API host and
# verify both hosts in Search Console (Google allows cross-host sitemaps then).
SITEMAP_URL=
